INSTANCE=_registry
NETWORK=network
TRAEFIK_ENABLE=true
TRAEFIK_DOMAIN=registry.localhost
TRAEFIK_ENTRYPOINT=web
# Стенд слушает только на 127.0.0.1: в нём лежат ключи и пароли от боевых серверов.
EXTERNAL_ACCESS=127.0.0.1:8090:80
# Пароль на страницы стенда. Работает, только когда заданы оба.
HTTP_LOGIN=
HTTP_PASSWORD=
NGINX_CONF=registry
# Версии образов запечены: latest уходит вперёд молча.
NGINX_VERSION=1.29-alpine
NODE_VERSION=22
# Версия pg_dump в образе. Должна быть не ниже версии самого старшего из ваших серверов postgres.
PG_CLIENT_VERSION=17
# Потолок загрузки через /upload на стороне nginx. Поднимая, поднимите и CR_MAX_UPLOAD_BYTES.
CLIENT_MAX_BODY_SIZE=256M

# MCP
NODE_MODE=mcp
MCP_PORT=8932
MCP_ACCESS=127.0.0.1:8932:8932
# База ссылок на страницы и артефакты в ответах агенту
PUBLIC_BASE_URL=http://127.0.0.1:8090

# Язык описаний инструментов MCP: ru | en | auto.
# Их читает модель, поэтому язык стоит выставлять по языку задач, а не интерфейса.
CR_LANG=ru

# Мастер-ключ шифрования секретов реестра. Без него сервер поднимается «запертым»:
# метаданные и заметки читаются, подключаться никуда нельзя.
# Сгенерировать: openssl rand -base64 32
# Ключ лежит рядом с базой, поэтому шифрование защищает копию тома и бэкап, а не живой хост.
CR_MASTER_KEY=
# Либо файл с ключом — если класть его в .env не хочется
CR_MASTER_KEY_FILE=

# Проверка обновлений: при старте стенд один раз спрашивает GitHub, какой релиз последний,
# и сравнивает с тегом из BUNDLE_IMAGE. Ничего не блокирует, ответ кэшируется на шесть часов.
# CR_UPDATE_CHECK=0 выключает её целиком — для контуров без выхода наружу, где запрос всё равно
# упрётся в таймаут. Форкам: CR_UPDATE_REPO и CR_UPDATE_IMAGE.
CR_UPDATE_CHECK=1

# Политика подтверждений: что именно спрашивается у человека.
#   base  — чтение свободно; на запись разрешение даётся один раз за сессию и один раз на проект;
#           хосты, подключения и секреты спрашиваются каждый раз.
#   loyal — разрешение выдаётся на область работы: доступ к проекту (на первом обращении к нему,
#           даже на чтение) открывает и заметки, и подключения, и секреты этого проекта; право
#           писать на сервер спрашивается отдельно и покрывает все подключения хоста сразу.
#           Проект, которого ещё нет, агент заводит сам и получает доступ без вопроса.
# Секреты не возвращает ни один инструмент при любой политике.
CR_POLICY=base

# Подтверждения. Сколько секунд ждать решения человека, прежде чем отказать вызову.
CR_APPROVE_TIMEOUT=300

# Журнал. Файлы JSONL в томе logs, вывод команд целиком.
CR_LOG_MAX_BYTES=1073741824
CR_LOG_FILE_BYTES=67108864
# Вывод крупнее этого уезжает в отдельный файл logs/blobs/<id>.txt
CR_LOG_INLINE_BYTES=262144

# Потолки ответов агенту: контекст модели дороже полноты вывода.
CR_MAX_TEXT_BYTES=131072
CR_DB_MAX_ROWS=500
CR_MAX_UPLOAD_BYTES=268435456
# Потолок вывода одной команды, который сервер держит в памяти
CR_MAX_OUTPUT_BYTES=33554432

# Транспорт
# Через сколько миллисекунд простоя закрывать SSH-соединение из пула
CR_SSH_IDLE_MS=300000
# Таймаут одной команды по умолчанию, миллисекунды
CR_EXEC_TIMEOUT=120000
